REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
QUEUE_CONCURRENCY=10
ENV=dev

# MongoDB
# Database name is fixed internally to: Torch-vendor
MONGO_URI=mongodb://localhost:27017

# Authentication Configuration
# Comma-separated list of enabled auth providers: email, discord, github
AUTH=discord,github

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# Session secret (change in production)
SESSION_SECRET=your-super-secret-session-key

# Discord OAuth (get from https://discord.com/developers/applications)
DC_CLIENT_ID=your_discord_client_id
DC_CLIENT_SECRET=your_discord_client_secret
DC_CALLBACK=http://localhost:8080/authenticate/discord/callback

# GitHub OAuth (get from https://github.com/settings/developers)
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret
GH_CALLBACK=http://localhost:8080/authenticate/github/callback


# User limits
# All forms of memory is in megabytes
CPU_LIMIT=100
MEMORY_LIMIT=2048
STORAGE_LIMIT=20040

# Sign up bonus credits
SIGNUP_BONUS=0
