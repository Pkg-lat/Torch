                        <div className="h-3 w-16 bg-neutral-300 dark:bg-neutral-700 rounded mb-2"></div>
                        <div className="h-8 w-20 bg-neutral-300 dark:bg-neutral-700 rounded"></div>
                      </BracketFrame>
                    </div>
                  ))
                ) : (
                  <>
                  {/*
                    <StatBox label="Servers" value={stats.servers} />
                    <StatBox label="Volumes" value={stats.volumes} />
                    <StatBox label="Storage" value={stats.storage} unit="MB" />
                    <StatBox label="Credits" value={stats.credits} unit="RU" />
                    */}
